   ]
  },
  {
   "@id": "wf:p3",
   "@type": [
    "wf:schema-Protocol",
    "mira:Protocol"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "PRO - Inference and scoring by precision@d, recall@d and parity F1",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Sample several-fold more candidates than expected, keep those above a confidence or density threshold, and cluster greedily within 1.52 Å. Score at d = 0.5 and 1.0 Å, with F1 at the point where predicted and deposited counts match."
   },
   "creator": "wf:creator",
   "bibliographicCitation": "Srivastava et al. 2026, doi:10.64898/2026.08.26.747373. Results: Inference; Evaluation Metrics; README: Selecting the final waters",
   "references": [
