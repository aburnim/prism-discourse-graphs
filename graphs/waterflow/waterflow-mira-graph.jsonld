   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "PRO - WaterFlow two-stage model: flow-matching generator and confidence model",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "A GVP network on a protein-water graph with ESM3 residue embeddings. The generator learns a velocity field from prior samples to water positions; the confidence model, initialized from the generator, scores candidates against a target near 1 within 0.5 Å that decays to 0 by about 1.5 Å."
   },
   "creator": "wf:creator",
   "bibliographicCitation": "Srivastava et al. 2026, doi:10.64898/2026.08.26.747373. Results: Encoder, Generator, and Confidence Model; Figure 1A; README: Training your own models",
   "references": [
