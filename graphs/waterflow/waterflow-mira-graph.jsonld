   ]
  },
  {
   "@id": "wf:p5",
   "@type": [
    "wf:schema-Protocol",
    "mira:Protocol"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "PRO - Symmetry mate expansion of the input graph",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Whole residues of symmetry-related copies, including ligands, ions and cofactors but not waters, with any atom within 8.0 Å of the asymmetric unit are added as protein nodes."
   },
   "creator": "wf:creator",
   "bibliographicCitation": "Srivastava et al. 2026, doi:10.64898/2026.08.26.747373. Results: Encoding Symmetry Mates Improves Prediction Accuracy, paragraph 1; README: Step 2"
  },
