   "@id": "sw:r1",
   "@type": [
    "sw:schema-Request",
    "mira:Request"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "REQ - Test latent-space optimization systematically across predictors",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "The authors expect it may cross density-free intermediates that coordinate guidance cannot. The README now lists a latent_opt guidance type for Protenix, RF3 and Boltz-1."
   },
   "creator": "sw:creator",
   "bibliographicCitation": "Chrispens et al. 2026, doi:10.82153/jkxj-tw08. Discussion, final paragraph; repository README, Latent optimization section",
   "references": [
    "https://doi.org/10.48550/arxiv.2602.05285",
    "https://doi.org/10.48550/arxiv.2602.24007"
   ]
  },
