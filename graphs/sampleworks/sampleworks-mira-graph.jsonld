   ]
  },
  {
   "@id": "sw:r4",
   "@type": [
    "sw:schema-Request",
    "mira:Request"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "REQ - Guide with real experimental data and other data types, not only simulated real-space maps",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "The README asks for fast differentiable modules for other data types. It now lists structure-factor and diffuse-plus-Bragg losses."
   },
   "creator": "sw:creator",
   "bibliographicCitation": "sampleworks README, github.com/prism-science/sampleworks. Repository README, Losses section; Discussion",
