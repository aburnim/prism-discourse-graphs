   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "PRO - Diffusion guidance: noise input to step 120 of 200, L2 density loss, normalized gradient times strength",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Loss is computed on denoised coordinates and backpropagated through the model to the noised coordinates. Coordinates are aligned to the input before each loss step."
   },
   "creator": "sw:creator",
   "bibliographicCitation": "Chrispens et al. 2026, doi:10.82153/jkxj-tw08. Methods: Guidance",
   "references": [
    "https://doi.org/10.48550/arxiv.2406.04239",
    "https://doi.org/10.48550/arxiv.2502.09372",
    "https://doi.org/10.48550/arxiv.2209.14687"
   ]
  },
  {
   "@id": "sw:p4",
   "@type": [
    "sw:schema-Protocol",
    "mira:Protocol"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "PRO - Ensemble evaluation: RSCC, lDDT clustering score, geometry penalty",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "RSCC within 2 A of the 3-residue sub-segment where altlocs differ most. Clustering score assigns each member to its nearest altloc by lDDT and scales by occupancy balance. Geometry penalty combines clashscore and bond length and angle outliers."
   },
   "creator": "sw:creator",
   "bibliographicCitation": "Chrispens et al. 2026, doi:10.82153/jkxj-tw08. Methods: Evaluation Metrics (geometry, RSCC, lDDT clustering)",
   "references": [
    "https://doi.org/10.1016/j.str.2022.08.004",
    "https://doi.org/10.1107/s2059798318002541",
    "https://doi.org/10.1002/pro.3330",
    "https://doi.org/10.1107/s2059798319011471",
    "https://doi.org/10.1093/bioinformatics/btt473",
    "https://doi.org/10.1016/0377-0427%2887%2990125-7"
   ]
  },
  {
