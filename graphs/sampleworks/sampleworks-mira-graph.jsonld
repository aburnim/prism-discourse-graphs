   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "REQ - Contribute ModelWrappers for more predictors, especially smaller, more steerable models",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Named as a wanted contribution in the repo README."
   },
   "creator": "sw:creator",
