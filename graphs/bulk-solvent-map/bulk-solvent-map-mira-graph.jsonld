  {
   "@id": "bsm:e8",
   "@type": [
    "bsm:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - Without propagation through select(), k_mask was fit to a recomputed flat mask",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Outlier removal rebuilt the f_model manager, which dropped the stored map, so the supplied map had no effect until the patch carried it through the in-place selection path."
   },
   "creator": "bsm:creator",
   "bibliographicCitation": "Holton and Wankowicz 2026, doi:10.82153/2me0-hd96. Reflection outlier rejection; README: Implementation notes",
   "sourceDocument": [
