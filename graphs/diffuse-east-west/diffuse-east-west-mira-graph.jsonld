   "title": "REQ - Build diffuse maps from larger numbers of crystals",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "To find how signal quality keeps improving as more datasets are merged."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Discussion, paragraph 2"
  },
