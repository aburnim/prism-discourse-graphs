   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "CLM - Merging crystals in diverse orientations improves reciprocal-space coverage and diffuse signal-to-noise",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Mac1 crystals sit on the loop in a preferred orientation. Sampling diverse orientations matters more than reaching a strict minimum number of crystals."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Results: 'Multi-Crystal Datasets', Figure 3",
