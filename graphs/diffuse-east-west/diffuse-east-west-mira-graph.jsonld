   "@type": [
    "dew:schema-Request",
    "mira:Request"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "REQ - Establish the mechanism of dose-dependent diffuse changes across systems beyond Mac1",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Different crystals may respond differently to X-ray dose, so the effects need systematic study."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Results: 'X-ray Dose', last paragraph; Discussion, paragraph 3"
