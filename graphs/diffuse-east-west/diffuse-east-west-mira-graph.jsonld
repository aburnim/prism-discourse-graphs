   "@type": [
    "dew:schema-Claim",
    "mira:Claim"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "CLM - Sleeve mounts allow a matched background measurement; oil mounts do not",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Translating along the sleeve gives an equivalent path length of the same material. Oil around the crystal varies between mounts and with rotation."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Results: 'Humidity', last paragraph; Discussion, paragraph 2",
