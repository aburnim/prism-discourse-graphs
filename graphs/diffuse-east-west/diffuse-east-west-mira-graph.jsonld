   "@type": [
    "dew:schema-Claim",
    "mira:Claim"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "CLM - Mac1 crystals need humidity control and a sleeve mount; oil coating offers little benefit",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Oil coating can compromise both crystal hydration and lattice order. Only a sleeve without oil matched the humidity-controlled references."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Results: 'Humidity', Figure 4",
