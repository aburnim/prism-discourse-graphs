   "@type": [
    "dew:schema-Claim",
    "mira:Claim"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "CLM - Radiation damage may be concentrated in microscopic regions or defects of the crystal",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Offered as one possible explanation, consistent with 4D-STEM images of nanoscale domain reorientation in lysozyme and myoglobin crystals. Not tested here."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Discussion, paragraph 3",
   "references": [
    "https://doi.org/10.1016/j.bpj.2026.08.008"
   ]
  },
