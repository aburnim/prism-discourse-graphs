   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "REQ - Determine how diffuse signal-to-noise propagates into the models derived from the maps",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "This will set the crystal size and signal strength needed for a given interpretive claim, including whether ~100 µm crystals are enough."
   },
   "creator": "dew:creator",
   "bibliographicCitation": "Zielinski et al. 2026, doi:10.82153/hrpy-t681. Discussion, paragraph 2"
  },
  {
