   ],
   "sourceDocument": [
    "https://doi.org/10.82153/pff0-ck46"
   ],
   "observationOriginActivity": "qfs:s3"
  },
  {
   "@id": "qfs:e6",
   "@type": [
    "qfs:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - 802 structures (1.3%) had Rfree rise by more than 0.05 after qFit",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "No pattern was found that explains the increase in these structures."
   },
   "creator": "qfs:creator",
   "bibliographicCitation": "Wankowicz 2026, doi:10.82153/pff0-ck46. Results: 'Multiconformer models improve fit to experimental data', Figure 3",
