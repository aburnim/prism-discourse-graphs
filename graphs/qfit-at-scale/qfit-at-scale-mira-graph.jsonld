   ],
   "observationOriginActivity": "qfs:s4"
  },
  {
   "@id": "qfs:e9",
   "@type": [
    "qfs:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - In DAPK1 (7CCU), qFit lowered Rfree from 0.189 to 0.1812 and added altlocs to 164 of 277 residues",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "The 1.65 Å deposited model has no altlocs; Rwork fell from 0.172 to 0.159. 85 of 277 residues had more than 2 altlocs. Removing altlocs within the same rotamer well leaves 144/277 (52%) and 48/277 (17.3%)."
   },
   "creator": "qfs:creator",
   "bibliographicCitation": "Wankowicz 2026, doi:10.82153/pff0-ck46. Results: 'Hidden heterogeneity in a high-quality structure', Figure 5A",
   "references": [
