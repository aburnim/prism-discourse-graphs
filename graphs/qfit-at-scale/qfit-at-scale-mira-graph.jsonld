  {
   "@id": "qfs:e7",
   "@type": [
    "qfs:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - qFit increased the altloc count for 9.4% of residues",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "90.4% of residues had one altloc in both models. Gains were +1 for 4.9%, +2 for 3.6% and +3 for 0.8% of residues; 0.2% lost altlocs. Leucine and cysteine gained the most (mean 0.16), glycine and alanine the least (mean 0.11)."
   },
   "creator": "qfs:creator",
   "bibliographicCitation": "Wankowicz 2026, doi:10.82153/pff0-ck46. Results: 'Multiconformer models have significantly more conformational heterogeneity...', Figure 4A, Supplementary Figure 1",
   "observationBase": [
    "https://thestacks-01.s3.amazonaws.com/publications/qfit-figure-update/media_ee3beb24_7a6caafb7032",
    "https://thestacks-01.s3.amazonaws.com/publications/qfit-at-scale/media_924f40fb_f3b4690c8a1c"
   ],
   "sourceDocument": [
    "https://doi.org/10.82153/pff0-ck46"
   ],
   "observationOriginActivity": "qfs:s4"
  },
  {
   "@id": "qfs:e8",
   "@type": [
    "qfs:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - qFit increased per-residue RMSF by a mean of 0.13 Å (median 0)",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "A small subset of residues shows large RMSF gains. Mean gains were largest for lysine (0.23 Å) and arginine (0.20 Å) and smallest for glycine (0.05 Å), alanine (0.06 Å) and proline (0.08 Å)."
   },
   "creator": "qfs:creator",
   "bibliographicCitation": "Wankowicz 2026, doi:10.82153/pff0-ck46. Results: 'Multiconformer models have significantly more conformational heterogeneity...', Figure 4B, Supplementary Figure 2",
   "observationBase": [
