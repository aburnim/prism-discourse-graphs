   ],
   "observationOriginActivity": "qfs:s1"
  },
  {
   "@id": "qfs:e5",
   "@type": [
    "qfs:schema-Evidence",
    "mira:Evidence"
   ],
   "created": "2026-10-27T00:00:00Z",
   "modified": "2026-10-27T00:00:00Z",
   "title": "EVD - qFit lowered Rfree for 54,274 of 60,549 structures (89.7%)",
   "description": {
    "@type": "Item",
    "format": "text/plain",
    "content": "Mean Rfree change was -0.009 and median -0.01. Per-structure changes ranged from a 0.320 decrease to a 0.310 increase (SD 0.026). The Purpose section gives 83.7% for this fraction."
   },
   "creator": "qfs:creator",
   "bibliographicCitation": "Wankowicz 2026, doi:10.82153/pff0-ck46. Results: 'Multiconformer models improve fit to experimental data', Figure 3A-B",
